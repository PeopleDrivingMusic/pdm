# Database Configuration — Supabase
# App queries: transaction-mode pooler (port 6543).
DATABASE_URL="postgresql://postgres.{project-ref}:{password}@{pooler-host}:6543/postgres"
# drizzle-kit migrations: session-mode pooler (port 5432, same pooler host — NOT
# the dashboard's "direct connection" host, which is IPv6-only and may be
# unreachable depending on network; session mode on the pooler is IPv4).
DIRECT_DATABASE_URL="postgresql://postgres.{project-ref}:{password}@{pooler-host}:5432/postgres"

# Local dev via `supabase start` instead (see local-development wiki page):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Environment
NODE_ENV=development

# Cloudflare R2 (media storage) — required for `svelte-kit sync` to generate
# correct $env/static/private and $env/static/public types, even as empty
# placeholders (see src/lib/db/services/R2Service.ts, ContentService.ts).
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PUBLIC_R2_IMAGES_BUCKET=

# Supabase Studio — http://127.0.0.1:54323 for local `supabase start`,
# the hosted project's dashboard URL otherwise.
PUBLIC_SUPABASE_STUDIO_URL=

# Optional: Production SSL configuration
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
