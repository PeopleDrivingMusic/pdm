# Database Configuration
DATABASE_URL="postgresql://{username}:{password}@{host}:{port}/{database}"

# Alternative Database Configuration (for manual setup)
DB_HOST={host}
DB_PORT={port}
DB_USERNAME={username}
DB_PASSWORD={password}
DB_NAME={database}

# Environment
NODE_ENV=development

# Cloudflare R2 (media storage) — required for `svelte-kit sync` to generate
# correct $env/static/private and $env/static/public types, even as empty
# placeholders (see src/lib/db/services/R2Service.ts, ContentService.ts).
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PUBLIC_R2_IMAGES_BUCKET=

# pgAdmin (local docker-compose only)
PUBLIC_PGADMIN_URL=

# Optional: Production SSL configuration
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
